<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>k5ctl</AssemblyName>
    <RootNamespace>K5Ctl</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- dotnet publish -c Release -r <rid>, on that platform: one native executable (NativeAOT,
         self-contained). Serial port access also needs libSystem.IO.Ports.Native.so beside it. -->
    <PublishAot>true</PublishAot>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/M0LTE.Uvk5/M0LTE.Uvk5.csproj" />
  </ItemGroup>

</Project>
